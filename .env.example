# =============================================================
# GatherPlus Environment Variables – EXAMPLE FILE
# Copy this file to .env and fill in your actual values.
# Never commit .env to source control.
# =============================================================

# --- Backend API Base URLs ---
EXPO_PUBLIC_BASE_URL=https://gather-plus-backend-core.onrender.com/api/v1
EXPO_PUBLIC_PROVIDER_URL=https://gather-plus-backend-event.onrender.com/api/v1/provider

# --- File Upload Endpoint ---
EXPO_PUBLIC_FILE_UPLOAD_URL=https://gather-plus-backend-core.onrender.com/api/v1/file

# --- Web / Share URL ---
EXPO_PUBLIC_WEB_URL=https://www.gatherplux.com

# --- Google Maps API Key (Android) ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Stripe Payment ---
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=merchant.your_apple_pay_merchant_id_here

# --- Paystack ---
# Paystack is initiated server-side; no public key is required on the frontend.
# Add one here if that changes:
# EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
