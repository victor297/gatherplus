EXPO_PUBLIC_APP_ENV=development

# For Android emulator use http://10.0.2.2:3000/api/v1.
# For a physical phone use your computer LAN IP, for example http://192.168.1.50:3000/api/v1.
EXPO_PUBLIC_CORE_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_PROVIDER_API_URL=http://localhost:3002/api/v1/provider
EXPO_PUBLIC_PAYMENT_BASE_URL=http://localhost:3002/api/v1/payment

# Web URLs are used for share links.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# File uploads use EXPO_PUBLIC_CORE_API_URL + /file by default.
# Set this only if uploads move to a different public endpoint.
# EXPO_PUBLIC_FILE_UPLOAD_URL=http://localhost:3000/api/v1/file

# Public Google Maps key for mobile maps.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Public Google reCAPTCHA v3 site key. Keep the secret key on the backend only.
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=6Lef2wwtAAAAABKg6M0vjzHkV7nmjpblwy1KQyw3
EXPO_PUBLIC_RECAPTCHA_ORIGIN_URL=https://www.gatherplux.com

# Public mobile payment key. Keep secret Stripe keys on the backend only.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
EXPO_PUBLIC_STRIPE_MERCHANT_IDENTIFIER=merchant.REPLACE_ME

# Paystack is initiated server-side; no public key is required on mobile.
# EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

# Set to true only when you intentionally want a dev bundle to hit production.
EXPO_PUBLIC_ALLOW_PRODUCTION_API_IN_DEV=false
